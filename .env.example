# ========================================================
# AgriLink AI - Environment Configuration Example
# ========================================================
# For LOCAL running: No .env file is needed!
# The backend automatically defaults to your local MySQL (localhost:3306).
#
# For CLOUD DEPLOYMENT (e.g. Render.com + TiDB Cloud / Aiven):
# Set either DATABASE_URL or the individual DB_* variables below in Render's dashboard.

# Server Port (Render sets this automatically)
PORT=5000

# Option A: Full Connection String (from TiDB Cloud or Aiven)
# DATABASE_URL=mysql://<user>:<password>@<host>:<port>/agrilink_ai?ssl={"rejectUnauthorized":true}

# Option B: Individual Database Parameters
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=@Soumajit2006
DB_NAME=agrilink_ai
DB_PORT=3306
DB_SSL=false
